config wgswitch 'main'
	# netifd interface that wgswitch manages. It is also the WireGuard
	# device name, so firewall zones can match it with `list device`.
	option interface 'wg0'
	# where profiles (.conf files, wg-quick format) live
	option conf_dir '/etc/wireguard'
	# what to do if the connected tunnel dies: fastest | block | direct
	#   fastest: switch to the fastest other profile that passes traffic,
	#            and if none does, apply 'fallback'
	option killswitch 'fastest'
	# fastest's last resort: direct (disconnect, go out without the VPN)
	# or block (no internet until a tunnel works again)
	option fallback 'direct'
	# split: route 0.0.0.0/1 + 128.0.0.0/1 (and ::/1 + 8000::/1) via the
	#        tunnel for full-tunnel profiles, keeping your default route
	#        underneath; allowed_ips: netifd's route_allowed_ips;
	#        none: install no routes (you route it yourself, e.g. pbr)
	option route_mode 'split'
	option check_interval '15'
	option fail_threshold '3'
	option handshake_timeout '180'
	option connect_timeout '20'
	option probe_timeout '7'
	option failover_candidates '5'
	list ping_target '1.1.1.1'
	list ping_target '1.0.0.1'
	# executable called with "connect" / "disconnect" (optional)
	option hook ''
	option hook_timeout '90'
	option probe_interface 'wgsprobe'
	option fwmark '0x5157'
	option probe_table '5157'
	option probe_rule_priority '5157'

config state 'state'
	option enabled '0'
