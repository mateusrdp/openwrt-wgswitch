#!/bin/sh /etc/rc.common
# wgswitch service: health checks + kill switch for the WireGuard client.
# The tunnel itself is brought up at boot by netifd (it's a normal
# interface with auto=1); this service watches it.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/wgswitch daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger wgswitch
}

reload_service() {
	# The daemon re-reads its config on every loop; HUP just wakes it up.
	procd_send_signal wgswitch '*' HUP
}
